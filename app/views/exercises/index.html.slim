h1 Exercises#index
div.flash-container
  - flash.each do |message|
    .flash-message
      = message
ul
  - @exercises.each do |exercise|
    li.exercise-row
      = link_to exercise.name, exercise_path(exercise)
      = button_to 'Delete Exercise', exercise_path(exercise),  { method: :delete }

div
    = link_to 'Add Exercise', new_exercise_path
